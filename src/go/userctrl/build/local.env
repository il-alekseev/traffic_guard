USER_CTRL_APP_ENV=production
USER_CTRL_IMAGE_NAME=usercontrol
GIN_MODE=debug

# Настройки приложения
USER_CTRL_APP_NAME=usercontrol             # Название приложения
USER_CTRL_APP_VERSION=1.0.0                # Версия приложения

# Настройки HTTP сервера
USER_CTRL_HTTP_PORT=8002                   # Порт HTTP сервера
USER_CTRL_HTTP_HOST=0.0.0.0              # Хост HTTP сервера

# Настройки логгирования
USER_CTRL_LOG_LEVEL=debug                  # Уровень логирования (debug/info/warn/error)

# Настройки Swagger
USER_CTRL_SWAGGER_HOST=192.168.130.112           # Хост для доступа к Swagger UI

# Настройки Keycloak
USER_CTRL_KEYCLOAK_PROTO=https             # Протокол подключения к Keycloak
USER_CTRL_KEYCLOAK_HOST=192.168.130.112      # Хост Keycloak
USER_CTRL_KEYCLOAK_PORT=8443               # Порт Keycloak
USER_CTRL_KEYCLOAK_LOGIN=system_admin      # Логин администратора Keycloak
USER_CTRL_KEYCLOAK_PASS=admin              # Пароль администратора Keycloak
USER_CTRL_KEYCLOAK_REALM=grafanasso              # Название realm в Keycloak
USER_CTRL_KEYCLOAK_SYSTEM_REALM=master     # Системный realm (master)
USER_CTRL_KEYCLOAK_GRAFANA_CLIENT_ID=grafana-sso  # Client ID для Grafana
USER_CTRL_KEYCLOAK_GRAFANA_CLIENT_UUID=29a7ef53-ad36-44f3-93be-a70270f439a2  # UUID клиента Grafana
USER_CTRL_KEYCLOAK_GRAFANA_CLIENT_SECRET=uAgEvDTaFYvzqr287p2qZFIi7habElf8  # Секрет клиента Grafana

# Настройки Grafana клиента
USER_CTRL_GRAFANA_PROTO=https
USER_CTRL_GRAFANA_PORT=3000
USER_CTRL_GRAFANA_HOST=192.168.130.112
USER_CTRL_GRAFANA_AUTH_PATH=/login/generic_oauth
USER_CTRL_GRAFANA_USERNAME=system_admin
USER_CTRL_GRAFANA_PASS=admin

# Настройки клиента сервиса Blog
USER_CTRL_BLOG_PROTO=http
USER_CTRL_BLOG_HOST=192.168.130.112
USER_CTRL_BLOG_PORT=8004