{
  "openapi": "3.0.0",
  "info": {
    "title": "NGFW Dashboard API",
    "description": "API для дашборда статистики NGFW (КСУ/КСФ)",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "url": "http://www.swagger.io/support",
      "email": "support@swagger.io"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "dashboard",
      "description": "Операции дашборда статистики NGFW"
    }
  ],
  "paths": {
    "/dashboard/requests": {
      "post": {
        "tags": ["dashboard"],
        "summary": "Получить статистику запросов",
        "description": "Возвращает количество запросов (заблокированные, разрешенные) в целом и по отдельному NGFW",
        "operationId": "getRequestStats",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimeRangeFilter"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestStatsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Неверные параметры запроса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/traffic": {
      "post": {
        "tags": ["dashboard"],
        "summary": "Получить статистику трафика",
        "description": "Возвращает объем трафика (исходящий, входящий) в целом и по отдельному NGFW",
        "operationId": "getTrafficStats",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimeRangeFilter"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrafficStatsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Неверные параметры запроса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/top-resources": {
      "post": {
        "tags": ["dashboard"],
        "summary": "Получить топ ресурсов и категорий",
        "description": "Возвращает топ 25 посещаемых ресурсов по доменным именам и топ 25 посещаемых категорий",
        "operationId": "getTopResources",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimeRangeFilter"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopResourcesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Неверные параметры запроса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/blocked-categories": {
      "post": {
        "tags": ["dashboard"],
        "summary": "Получить запрещающие категории",
        "description": "Возвращает сработавшие запрещающие категории в целом и по отдельному NGFW",
        "operationId": "getBlockedCategories",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimeRangeFilter"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlockedCategoriesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Неверные параметры запроса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/blocked-resources": {
      "post": {
        "tags": ["dashboard"],
        "summary": "Получить ресурсы запрещенных категорий",
        "description": "Возвращает ресурсы которые относятся к запрещенным категориям с детальной информацией",
        "operationId": "getBlockedResources",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimeRangeFilter"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlockedResourcesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Неверные параметры запроса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/ngfw": {
      "get": {
        "tags": ["dashboard"],
        "summary": "Получить список NGFW",
        "description": "Возвращает список всех доступных межсетевых экранов",
        "operationId": "getNGFWList",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NGFW"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/categories": {
      "get": {
        "tags": ["dashboard"],
        "summary": "Получить список категорий",
        "description": "Возвращает список всех категорий ресурсов",
        "operationId": "getCategoriesList",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TimeRangeFilter": {
        "type": "object",
        "required": ["start", "end"],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Начало периода",
            "example": "2024-01-15T10:00:00Z"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "Конец периода",
            "example": "2024-01-15T11:00:00Z"
          },
          "ngfw_ids": {
            "type": "array",
            "description": "Фильтр по NGFW (опционально)",
            "items": {
              "type": "string"
            },
            "example": ["ngfw-1", "ngfw-2"]
          },
          "category_ids": {
            "type": "array",
            "description": "Фильтр по категориям (опционально)",
            "items": {
              "type": "string"
            },
            "example": ["category-1", "category-2"]
          }
        }
      },
      "RequestStatsResponse": {
        "type": "object",
        "properties": {
          "total": {
            "$ref": "#/components/schemas/RequestStats"
          },
          "by_ngfw": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/RequestStats"
            },
            "description": "Статистика по NGFW"
          },
          "period": {
            "$ref": "#/components/schemas/TimeRange"
          }
        }
      },
      "TrafficStatsResponse": {
        "type": "object",
        "properties": {
          "total": {
            "$ref": "#/components/schemas/TrafficStats"
          },
          "by_ngfw": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TrafficStats"
            },
            "description": "Статистика по NGFW"
          },
          "period": {
            "$ref": "#/components/schemas/TimeRange"
          }
        }
      },
      "TopResourcesResponse": {
        "type": "object",
        "properties": {
          "top_domains": {
            "type": "array",
            "description": "Топ 25 ресурсов по доменным именам",
            "items": {
              "$ref": "#/components/schemas/ResourceItem"
            }
          },
          "top_categories": {
            "type": "array",
            "description": "Топ 25 категорий",
            "items": {
              "$ref": "#/components/schemas/CategoryItem"
            }
          },
          "period": {
            "$ref": "#/components/schemas/TimeRange"
          }
        }
      },
      "BlockedCategoriesResponse": {
        "type": "object",
        "properties": {
          "blocked_categories": {
            "type": "array",
            "description": "Сработавшие запрещающие категории",
            "items": {
              "$ref": "#/components/schemas/BlockedCategory"
            }
          },
          "period": {
            "$ref": "#/components/schemas/TimeRange"
          }
        }
      },
      "BlockedResourcesResponse": {
        "type": "object",
        "properties": {
          "resources": {
            "type": "array",
            "description": "Ресурсы запрещенных категорий",
            "items": {
              "$ref": "#/components/schemas/BlockedResource"
            }
          },
          "total": {
            "type": "integer",
            "description": "Общее количество"
          },
          "period": {
            "$ref": "#/components/schemas/TimeRange"
          }
        }
      },
      "RequestStats": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Общее количество запросов"
          },
          "allowed": {
            "type": "integer",
            "format": "int64",
            "description": "Разрешенные запросы"
          },
          "blocked": {
            "type": "integer",
            "format": "int64",
            "description": "Заблокированные запросы"
          },
          "requests_per_second": {
            "type": "number",
            "format": "float",
            "description": "Запросов в секунду"
          }
        }
      },
      "TrafficStats": {
        "type": "object",
        "properties": {
          "total_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Общий объем трафика в байтах"
          },
          "incoming": {
            "type": "integer",
            "format": "int64",
            "description": "Входящий трафик"
          },
          "outgoing": {
            "type": "integer",
            "format": "int64",
            "description": "Исходящий трафик"
          },
          "bytes_per_second": {
            "type": "number",
            "format": "float",
            "description": "Байт в секунду"
          }
        }
      },
      "ResourceItem": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Доменное имя"
          },
          "request_count": {
            "type": "integer",
            "format": "int64",
            "description": "Количество обращений"
          },
          "last_access": {
            "type": "string",
            "format": "date-time",
            "description": "Последнее обращение"
          },
          "ngfw_id": {
            "type": "string",
            "description": "ID NGFW через которое было обращение"
          }
        }
      },
      "CategoryItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID категории"
          },
          "name": {
            "type": "string",
            "description": "Название категории"
          },
          "request_count": {
            "type": "integer",
            "format": "int64",
            "description": "Количество обращений"
          }
        }
      },
      "BlockedCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID категории"
          },
          "name": {
            "type": "string",
            "description": "Название категории"
          },
          "block_count": {
            "type": "integer",
            "format": "int64",
            "description": "Количество блокировок"
          },
          "description": {
            "type": "string",
            "description": "Описание категории"
          }
        }
      },
      "BlockedResource": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "string",
            "description": "IP адрес ресурса"
          },
          "domain": {
            "type": "string",
            "description": "Доменное имя"
          },
          "source_ip": {
            "type": "string",
            "description": "IP источник"
          },
          "url": {
            "type": "string",
            "description": "Полный URL"
          },
          "request_count": {
            "type": "integer",
            "format": "int64",
            "description": "Количество обращений за период"
          },
          "last_access": {
            "type": "string",
            "format": "date-time",
            "description": "Последнее обращение"
          },
          "ngfw_id": {
            "type": "string",
            "description": "ID NGFW через которое было обращение"
          },
          "category_id": {
            "type": "string",
            "description": "ID категории"
          },
          "category_name": {
            "type": "string",
            "description": "Название категории"
          }
        }
      },
      "TimeRange": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Начало периода"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "Конец периода"
          }
        }
      },
      "NGFW": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Уникальный идентификатор NGFW"
          },
          "name": {
            "type": "string",
            "description": "Имя NGFW"
          },
          "type": {
            "type": "string",
            "description": "Тип (КСУ или КСФ)",
            "enum": ["КСУ", "КСФ"]
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Уникальный идентификатор категории"
          },
          "name": {
            "type": "string",
            "description": "Название категории"
          },
          "description": {
            "type": "string",
            "description": "Описание категории"
          },
          "is_blocking": {
            "type": "boolean",
            "description": "Является ли категория запрещающей"
          },
          "request_count": {
            "type": "integer",
            "format": "int64",
            "description": "Количество обращений"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Сообщение об ошибке"
          },
          "code": {
            "type": "integer",
            "description": "Код ошибки"
          },
          "details": {
            "type": "string",
            "description": "Детали ошибки"
          }
        }
      }
    }
  }
}