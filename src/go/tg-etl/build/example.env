# App Configuration
ETL_APP_NAME=tg-etl
ETL_APP_VERSION=1.0.1

# HTTP Configuration
ETL_HTTP_HOST=0.0.0.0
ETL_HTTP_PORT=7001

# Swagger Configuration
ETL_SWAGGER=0.0.0.0:7001

# Logger Configuration
ETL_LOG_LEVEL=debug

# KSU PostgreSQL Configuration
ETL_KSU_PG_POOL_MAX=2
ETL_KSU_PG_HOST=192.168.130.112
ETL_KSU_PG_PORT=5432
ETL_KSU_USER=ksu_user
ETL_KSU_PASS=ksu_password
ETL_KSU_DBNAME=ksu
ETL_KSU_SSLMODE=disable

# ETL PostgreSQL Configuration
ETL_PG_POOL_MAX=2
ETL_PG_HOST=192.168.130.112
ETL_PG_PORT=5433
ETL_USER=etl_user
ETL_PASS=etl_password
ETL_DBNAME=etl
ETL_SSLMODE=disable

# ETL Controller Configuration
ETL_CACHE_TTL=10
ETL_REFRESH=10
ETL_BATCHSIZE=100
ETL_ML_ATTEMPS=20
ETL_BLACKLIST_TRIES_COUNT=10

# Kafka Configuration
ETL_KAFKA_HOST=192.168.130.112
ETL_KAFKA_PORT=9092
ETL_KAFKA_URL_TOPIC=url-processing-requests
ETL_KAFKA_METADATA_TOPIC=url-metadata-results
ETL_KAFKA_ML_TOPIC=ml-analysis-results

# UsercontrolClient
ETL_USERCONTROL_PROTO=http           # Протокол для UserControl сервиса
ETL_USERCONTROL_HOST=127.0.0.1       # Хост UserControl сервиса
ETL_USERCONTROL_PORT=8002            # Порт UserControl сервиса

#Blogclient
ETL_BLOG_SERV_PROTO=http
