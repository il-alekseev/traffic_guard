{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API для ETL",
        "title": "ETL API",
        "contact": {},
        "version": "1.0"
    },
    "host": "127.0.0.1:7001",
    "basePath": "/api/v1",
    "paths": {
        "/healthcheck": {
            "get": {
                "description": "Проверка, что сервер работает",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "utils"
                ],
                "summary": "Проверка работоспособности сервера",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.SuccessResponse"
                        }
                    }
                }
            }
        },
        "/version": {
            "get": {
                "description": "Возвращает информацию о версии, времени сборки и коммите",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "utils"
                ],
                "summary": "Получение версии ETL",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.SuccessResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.SuccessResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        }
    }
}